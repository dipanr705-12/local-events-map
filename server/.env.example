# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Configuration (SQLite file path)
DB_PATH=./data/events.db

# Optional Map Provider Tile Layer (Defaults to OpenStreetMap if empty)
# Example Mapbox: https://api.mapbox.com/styles/v1/{id}/tiles/{z}/{x}/{y}?access_token={accessToken}
# Example CartoDB Voyager: https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
