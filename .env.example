# ==========================================
# Local Events Map - Environment Variables
# ==========================================

# Server Port
PORT=5000

# Client Application URL (for CORS)
CORS_ORIGIN=http://localhost:5173

# SQLite Database File Path
DB_PATH=./data/events.db

# Optional Custom Map Tile Provider (Defaults to OpenStreetMap - no API key required)
# Mapbox Example:
# MAP_TILE_URL=https://api.mapbox.com/styles/v1/{id}/tiles/{z}/{x}/{y}?access_token=YOUR_MAPBOX_TOKEN
# CartoDB Voyager Example:
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
